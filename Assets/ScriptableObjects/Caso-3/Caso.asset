--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f1837a090c56f9244b39e08eb3ea4e40, type: 3}
  m_Name: Caso
  m_EditorClassIdentifier: Assembly-CSharp::DatosCaso
  tituloCaso: '<b>CASO 3: El Cuadro Manchado del Taller de Artes</b>'
  descripcionCaso: "Durante la clase de Artes Visuales, Sof\xEDa dej\xF3 secar su
    cuadro en el caballete. Al regresar, \xA1ten\xEDa una gran mancha de pintura
    azul fresca!"
  imagenFondo: {fileID: 21300000, guid: 81ff7862ae3f6ed4fb0acd9352123fb2, type: 3}
  testigos:
  - {fileID: 11400000, guid: 50f1a0301566f9244b39e08eb3ea4e11, type: 2}
  - {fileID: 11400000, guid: ea7300301566f9244b39e08eb3ea4e11, type: 2}
  - {fileID: 11400000, guid: b10000301566f9244b39e08eb3ea4e11, type: 2}
  - {fileID: 11400000, guid: d00470301566f9244b39e08eb3ea4e11, type: 2}
  tituloMinijuego: MINIJUEGO #4
  nombreMinijuego: Descarte de Rumores e Inconsistencias
  descripcionMinijuego: "El cuadro de Sof\xEDa fue manchado con pintura azul durante
    la clase de arte.\n\nAnaliza los testimonios y excusas de los sospechosos y arrastra
    la nota falsa a la Papelera en cada nivel para resolver el caso."
  pistasMinijuego3:
  - idPista: 1
    textoPista: "Tarro de pintura azul destapado y ca\xEDdo en el suelo junto al
      caballete"
    esCorrecta: 1
  - idPista: 2
    textoPista: "Pu\xF1o de la sudadera gris de Bruno manchado de azul fresco"
    esCorrecta: 1
  - idPista: 3
    textoPista: "Caja de l\xE1pices de madera de colores de Sof\xEDa"
    esCorrecta: 0
  - idPista: 4
    textoPista: Dorso de la mano derecha de Bruno manchado de pintura azul fresca
    esCorrecta: 1
  - idPista: 5
    textoPista: Un pincel delgado con pintura verde seca sobre la mesa
    esCorrecta: 0
  nivelesMinijuego4:
  - nivel: 1
    persona: "Sof\xEDa"
    pregunta: "Arrastra la nota con la excusa falsa de Sof\xEDa a la Papelera"
    opciones:
    - id: 1
      texto: "Sof\xEDa dej\xF3 su lienzo en el caballete para que se secara."
      esContradiccion: 0
      explicacion: 
    - id: 2
      texto: "Sof\xEDa fue a lavarse las manos mientras el cuadro se secaba."
      esContradiccion: 0
      explicacion: 
    - id: 3
      texto: "Un p\xE1jaro entr\xF3 volando por la ventana y derram\xF3 la pintura
        azul con sus alas."
      esContradiccion: 1
      explicacion: "Fue una salpicadura por un tarro ca\xEDdo tras un tropiezo humano,
        no por un ave."
    - id: 4
      texto: "Al regresar, el lienzo ten\xEDa una gran mancha de pintura azul."
      esContradiccion: 0
      explicacion: 
  - nivel: 2
    persona: Mateo
    pregunta: Arrastra la nota con la excusa falsa de Mateo a la Papelera
    opciones:
    - id: 1
      texto: "Mateo estaba pintando en el caballete contiguo al de Sof\xEDa."
      esContradiccion: 0
      explicacion: 
    - id: 2
      texto: "Llovi\xF3 agua de color azul desde la l\xE1mpara del techo sobre el
        cuadro."
      esContradiccion: 1
      explicacion: "La mancha era pintura acr\xEDlica azul brillante gruesa de tarro,
        no agua del techo."
    - id: 3
      texto: Mateo vio a Bruno pasar apresurado con un tarro de pintura azul.
      esContradiccion: 0
      explicacion: 
    - id: 4
      texto: "Mateo escuch\xF3 un ruido cerca del caballete de Sof\xEDa."
      esContradiccion: 0
      explicacion: 
  - nivel: 3
    persona: Bruno (CULPABLE)
    pregunta: "Arrastra la nota con la contradicci\xF3n delatadora de Bruno a la
      Papelera"
    opciones:
    - id: 1
      texto: "Se encontr\xF3 un tarro de pintura azul destapado y ca\xEDdo en el
        suelo."
      esContradiccion: 0
      explicacion: 
    - id: 2
      texto: "Bruno ten\xEDa manchas de pintura azul fresca en el pu\xF1o de su sudadera."
      esContradiccion: 0
      explicacion: 
    - id: 3
      texto: "Bruno afirma que \xE9l solo us\xF3 t\xE9mperas amarillas para un sol
        y que estuvo a m\xE1s de 5 metros de Sof\xEDa."
      esContradiccion: 1
      explicacion: "\xA1Contradicci\xF3n delatadora! Bruno ment\xEDa; ten\xEDa pintura
        azul fresca en la paleta, en el pu\xF1o de la sudadera y en la mano."
    - id: 4
      texto: "Bruno llevaba una paleta de mezcla en sus manos al pasar por el \xE1rea."
      esContradiccion: 0
      explicacion: 
  textoVictoriaResumen: "\xA1Excelente trabajo de investigaci\xF3n!\n\nHas desmentido
    las excusas del Taller de Artes y descubierto a Bruno:\n\u2022 Mateo lo vio pasar
    apresurado con el tarro de pintura azul.\n\u2022 Ten\xEDa el pu\xF1o de su sudadera
    y el dorso de la mano manchados de pintura azul fresca.\n\n\xA1Caso #3 resuelto
    con \xE9xito!"
