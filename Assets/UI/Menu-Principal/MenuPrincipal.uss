.menu-container {
    width: 100%;
    height: 100%;
    max-width: 1920px;
    max-height: 1080px;
    align-self: center;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    padding: 30px 54px;
}

/* Fondo Blur 100% Cobertura */
.fondo-escuela {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    background-image: url('project://database/Assets/UI/Backgrounds/fondo-escuela-pasillo-blur.png?fileID=2800000&guid=b0ae33aaa5d89e443bedbe6aa7e6e84d#fondo-escuela-pasillo-blur');
    -unity-background-scale-mode: scale-and-crop;
}

/* HEADER MENU */
.header-menu {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    margin-top: 8px;
    margin-bottom: 16px;
    flex-shrink: 0;
}

.txt-subtitulo {
    font-size: 22px;
    color: #EBD7B2;
    -unity-font-style: bold;
    letter-spacing: 3px;
    margin-bottom: 6px;
}

.txt-titulo {
    font-size: 52px;
    color: #FFFFFF;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* LAYOUT DE CARRUSEL CON PREVISUALIZACIÓN LATERAL */
.carrusel-layout {
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    width: 100%;
    max-width: 1650px;
    align-self: center;
    flex-grow: 1;
    min-height: 0;
    margin-bottom: 20px;
}

/* BOTONES NAVEGADORES CIRCULARES 2.5D (FLECHAS) */
.btn-nav-carrusel {
    width: 80px;
    height: 80px;
    flex-shrink: 0;
    border-radius: 40px;
    background-color: #FDF4E3;
    border-width: 4px;
    border-color: #3E2B1E;
    border-bottom-width: 8px;
    border-bottom-color: #24180F;
    color: #2F1B08;
    font-size: 32px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin: 0 16px;
}

.btn-nav-carrusel:hover {
    scale: 1.08;
}

.btn-nav-carrusel.deshabilitado {
    opacity: 0.35;
    background-color: #D9D2C5;
}

/* TARJETAS LATERALES PREVISUALIZACIÓN (MÁS PEQUEÑAS 3D) */
.card-caso-side {
    width: 300px;
    height: 310px;
    flex-shrink: 0;
    background-color: #F7EAD0;
    border-radius: 18px;
    border-width: 4px;
    border-color: #554030;
    border-bottom-width: 7px;
    border-bottom-color: #35261B;
    padding: 22px;
    opacity: 0.65;
    scale: 0.88;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
}

.badge-caso-side {
    align-self: flex-start;
    padding: 6px 16px;
    border-radius: 12px;
    background-color: #8C6A48;
    margin-bottom: 14px;
}

.txt-badge-side {
    font-size: 15px;
    -unity-font-style: bold;
    color: #FFFFFF;
}

.txt-caso-titulo-side {
    font-size: 21px;
    color: #3E2B1E;
    -unity-font-style: bold;
    white-space: normal;
    line-height: 28px;
}

/* TARJETA DE CASO CENTRAL (CARRUSEL 2.5D GRAN TAMAÑO) */
.card-caso-carrusel {
    width: 680px;
    max-width: 720px;
    height: 450px;
    flex-shrink: 0;
    background-color: #FDF4E3;
    border-radius: 24px;
    border-width: 5px;
    border-color: #3E2B1E;
    border-bottom-width: 10px;
    border-bottom-color: #24180F;
    padding: 32px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    margin: 0 24px;
}

.card-header-row {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 14px;
    flex-shrink: 0;
}

.badge-caso {
    padding: 8px 22px;
    border-radius: 14px;
    border-width: 3px;
    background-color: #E67700;
    border-color: #B75900;
}

.txt-badge {
    font-size: 19px;
    -unity-font-style: bold;
    color: #FFFFFF;
}

.card-body-col {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    min-height: 0;
    justify-content: flex-start;
}

.txt-caso-titulo {
    font-size: 34px;
    color: #2F1B08;
    -unity-font-style: bold;
    margin-bottom: 14px;
    white-space: normal;
    line-height: 42px;
}

.txt-caso-desc {
    font-size: 22px;
    color: #4A3525;
    white-space: normal;
    line-height: 31px;
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
}

/* BOTÓN INICIAR INVESTIGACIÓN 2.5D */
.btn-iniciar-caso {
    height: 72px;
    flex-shrink: 0;
    border-radius: 18px;
    border-width: 4px;
    border-color: #125438;
    border-bottom-width: 8px;
    border-bottom-color: #0B3825;
    background-color: #38D9A9;
    font-size: 26px;
    -unity-font-style: bold;
    color: #0A2B1D;
    -unity-text-align: middle-center;
}

.btn-iniciar-caso:hover {
    scale: 1.03;
}

/* FOOTER CARRUSEL (INDICADORES) */
.footer-carrusel {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 12px 34px;
    background-color: rgba(30, 20, 10, 0.88);
    border-radius: 18px;
    border-width: 3px;
    border-color: #FDF4E3;
    flex-shrink: 0;
}

.txt-contador-caso {
    font-size: 21px;
    color: #FFFFFF;
    -unity-font-style: bold;
    margin-bottom: 6px;
}

.indicadores-puntos {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.punto-indicador {
    width: 16px;
    height: 16px;
    border-radius: 8px;
    background-color: #7A6956;
    margin: 0 6px;
}

.punto-indicador.activo {
    width: 36px;
    border-radius: 8px;
    background-color: #38D9A9;
}

.oculta {
    display: none;
}
